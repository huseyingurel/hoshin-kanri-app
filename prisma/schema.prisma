// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  
  headId      String?
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id])
  
  users       User[]
  actionPlans ActionPlan[]
  kpis        KPI[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String?
  role           String   @default("USER") // ADMIN, PMO, EXECUTIVE (kurum geneli); DEPT_HEAD, KPI_OWNER, USER + departmentId → departman KPI/plan kapsamı (uygulama: access.ts / dataScope.ts)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  
  hoshinsSponsored     Hoshin[]       @relation("HoshinSponsor")
  actionPlansOwned     ActionPlan[]   @relation("ActionPlanOwner")
  kpisOwned            KPI[]          @relation("KPIOwner")
  periodRecordsSubmitted KPIPeriodRecord[] @relation("PeriodRecordSubmitter")
  countermeasuresOwned Countermeasure[] @relation("CountermeasureOwner")
  reviewsOrganized     Review[]  @relation("ReviewOrganizer")
  decisionsAssigned    Decision[] @relation("DecisionAssignee")

  departmentHeadOf     Department[] @relation("DepartmentHead")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Hoshin {
  id              String   @id @default(cuid())
  title           String
  description     String?
  year            Int
  type            String   // BREAKTHROUGH, ANNUAL
  status          String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, CANCELLED
  sponsorUserId   String?
  sponsorUser     User?    @relation("HoshinSponsor", fields: [sponsorUserId], references: [id])
  
  majorTasks      MajorTask[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([title, year])
}

model MajorTask {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  priority             String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  status               String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  hoshinId             String
  hoshin               Hoshin   @relation(fields: [hoshinId], references: [id], onDelete: Cascade)
  
  actionPlans          ActionPlan[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ActionPlan {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  startDate            DateTime?
  dueDate              DateTime?
  progressPercent      Int      @default(0)
  status               String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, DELAYED
  
  majorTaskId          String
  majorTask            MajorTask @relation(fields: [majorTaskId], references: [id], onDelete: Cascade)
  
  ownerUserId          String?
  ownerUser            User?     @relation("ActionPlanOwner", fields: [ownerUserId], references: [id])
  
  responsibleDeptId    String?
  responsibleDept      Department? @relation(fields: [responsibleDeptId], references: [id])

  kpis                 KPI[]
  decisions            Decision[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model KPI {
  id                   String   @id @default(cuid())
  name                 String
  definition           String?
  unit                 String   // %, #, $, etc.
  targetYear           Float
  reportingFrequency   String   @default("MONTHLY") // MONTHLY, QUARTERLY
  
  actionPlanId         String?
  actionPlan           ActionPlan? @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  
  ownerUserId          String?
  ownerUser            User?       @relation("KPIOwner", fields: [ownerUserId], references: [id])
  
  responsibleDeptId    String?
  responsibleDept      Department? @relation(fields: [responsibleDeptId], references: [id])

  periodRecords        KPIPeriodRecord[]
  countermeasures      Countermeasure[]
  decisions            Decision[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model KPIPeriodRecord {
  id                   String   @id @default(cuid())
  kpiId                String
  kpi                  KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  
  periodStart          DateTime
  periodEnd            DateTime
  targetValue          Float
  actualValue          Float?
  variance             Float?
  statusColor          String?  // RED, AMBER, GREEN
  ownerComment         String?
  
  submittedById        String?
  submittedBy          User?    @relation("PeriodRecordSubmitter", fields: [submittedById], references: [id])
  submittedAt          DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Countermeasure {
  id                   String   @id @default(cuid())
  kpiId                String?
  kpi                  KPI?     @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  
  problemStatement     String
  rootCause            String?
  actionSummary        String?
  
  ownerUserId          String?
  ownerUser            User?    @relation("CountermeasureOwner", fields: [ownerUserId], references: [id])
  
  dueDate              DateTime?
  expectedImpact       String?
  status               String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  closureNote          String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Review {
  id                   String   @id @default(cuid())
  title                String
  type                 String   // MEETING, EXPERT_REVIEW
  date                 DateTime
  status               String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  
  organizerId          String?
  organizer            User?    @relation("ReviewOrganizer", fields: [organizerId], references: [id])
  
  decisions            Decision[]
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Decision {
  id                   String   @id @default(cuid())
  reviewId             String
  review               Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  decisionText         String
  status               String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  dueDate              DateTime?
  
  kpiId                String?
  kpi                  KPI?     @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  
  actionPlanId         String?
  actionPlan           ActionPlan? @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  
  assigneeId           String?
  assignee             User?    @relation("DecisionAssignee", fields: [assigneeId], references: [id])
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
